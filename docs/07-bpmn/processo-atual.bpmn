<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Avaliação de competências (processo atual)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_RH" name="RH">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Gestor" name="Gestor">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Colab" name="Colaborador">
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Início do ciclo anual"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="T1" name="Definir competências por cargo (documento Word)"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T2" name="Montar planilha de avaliação"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T3" name="Enviar planilha por e-mail aos gestores"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T4" name="Preencher planilha de cada colaborador"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T5" name="Devolver planilha por e-mail"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Todas entregues no prazo?"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:outgoing>F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="T6" name="Cobrar gestores atrasados por e-mail"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T7" name="Consolidar respostas manualmente em planilha geral"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T8" name="Conferir erros e campos em branco"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T9" name="Gerar resultado final por pessoa"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T10" name="Conduzir conversa de feedback"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T11" name="Receber feedback"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End" name="Ciclo encerrado"><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="G1" />
    <bpmn:sequenceFlow id="F7" sourceRef="G1" targetRef="T6" name="Não" />
    <bpmn:sequenceFlow id="F8" sourceRef="T6" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" sourceRef="G1" targetRef="T7" name="Sim" />
    <bpmn:sequenceFlow id="F10" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F11" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="F12" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F13" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="F14" sourceRef="T11" targetRef="End" />
    <bpmn:textAnnotation id="A1"><bpmn:text>D-05: catálogo de competências em documento Word</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2"><bpmn:text>D-03: planilhas circulam por e-mail, sem controle de acesso</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3"><bpmn:text>D-07, D-08, D-12: escala sem padrão, avaliação pela memória recente, planilha longa</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A4"><bpmn:text>D-04: atrasos sem controle de prazo</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A5"><bpmn:text>D-01: cerca de 3 semanas de consolidação manual</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A6"><bpmn:text>D-02: fórmulas quebradas e campos em branco</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A7"><bpmn:text>D-09: sem painel por pessoa ou equipe</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A8"><bpmn:text>D-10: sem acompanhamento depois do feedback</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A9"><bpmn:text>D-11: colaborador recebe o resultado tarde e sem conhecer os critérios</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A10"><bpmn:text>D-06: colaborador e colegas não participam; só o chefe avalia (sem 360 e sem anonimato)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A1" sourceRef="A1" targetRef="T1" />
    <bpmn:association id="As_A2" sourceRef="A2" targetRef="T3" />
    <bpmn:association id="As_A3" sourceRef="A3" targetRef="T4" />
    <bpmn:association id="As_A4" sourceRef="A4" targetRef="T6" />
    <bpmn:association id="As_A5" sourceRef="A5" targetRef="T7" />
    <bpmn:association id="As_A6" sourceRef="A6" targetRef="T8" />
    <bpmn:association id="As_A7" sourceRef="A7" targetRef="T9" />
    <bpmn:association id="As_A8" sourceRef="A8" targetRef="T10" />
    <bpmn:association id="As_A9" sourceRef="A9" targetRef="T11" />
  </bpmn:process>
